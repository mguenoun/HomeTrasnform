rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/familyMembers/$(request.auth.token.email));
    }

    function isAllowedType() {
      return request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('image/jpeg') ||
        request.resource.contentType.matches('image/png');
    }

    function isAllowedSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    match /tasks/{taskId}/{fileName} {
      allow read: if isFamilyMember();
      allow create: if isFamilyMember() && isAllowedType() && isAllowedSize();
      allow delete: if isFamilyMember();
    }
  }
}
