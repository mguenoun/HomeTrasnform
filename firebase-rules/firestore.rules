rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Le nom de la collection ("familymembers", tout en minuscules) doit être
    // reproduit exactement tel quel dans la console Firestore : les chemins sont
    // sensibles à la casse, une collection nommée différemment (ex: "familyMembers")
    // rendrait exists() ci-dessous silencieusement faux pour tout le monde.
    function isFamilyMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/familymembers/$(request.auth.token.email));
    }

    match /familymembers/{email} {
      allow read: if isFamilyMember();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isFamilyMember();
      allow write: if isFamilyMember() && request.auth.uid == userId;
    }

    match /objectives/{objectiveId} {
      allow read: if isFamilyMember();
      allow create, update, delete: if isFamilyMember();
    }

    match /tasks/{taskId} {
      allow read: if isFamilyMember();
      allow create, update, delete: if isFamilyMember();

      match /comments/{commentId} {
        allow read: if isFamilyMember();
        allow create, update, delete: if isFamilyMember();
      }

      match /attachments/{attachmentId} {
        allow read: if isFamilyMember();
        allow create, update, delete: if isFamilyMember();

        // Le contenu du fichier (encodé en base64) est découpé en morceaux
        // de documents ici, pour rester sous la limite de 1 Mio par document
        // Firestore — voir src/domain/attachments.ts.
        match /chunks/{chunkId} {
          allow read: if isFamilyMember();
          allow create, update, delete: if isFamilyMember();
        }
      }
    }
  }
}
