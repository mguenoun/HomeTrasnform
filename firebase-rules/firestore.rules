rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Le nom de la collection ("familymembers", tout en minuscules) doit être
    // reproduit exactement tel quel dans la console Firestore : les chemins sont
    // sensibles à la casse, une collection nommée différemment (ex: "familyMembers")
    // rendrait exists() ci-dessous silencieusement faux pour tout le monde.
    function isFamilyMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/familymembers/$(request.auth.token.email));
    }

    match /familymembers/{email} {
      allow read: if isFamilyMember();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isFamilyMember();
      allow write: if isFamilyMember() && request.auth.uid == userId;
    }

    // Un objectif "private" n'est visible/modifiable que par son créateur ; les
    // objectifs sans champ visibility (créés avant cette fonctionnalité) ou avec
    // visibility == "shared" restent visibles par toute la famille, comme avant.
    // .get('visibility', 'shared') (plutôt que .visibility) : accès sûr, retombe
    // explicitement sur 'shared' si le champ est absent, au lieu de dépendre du
    // comportement du moteur de règles sur un champ manquant.
    function isPrivateObjective(objectiveId) {
      return objectiveId != null &&
        exists(/databases/$(database)/documents/objectives/$(objectiveId)) &&
        get(/databases/$(database)/documents/objectives/$(objectiveId)).data.get('visibility', 'shared') == 'private';
    }

    function ownsObjective(objectiveId) {
      return objectiveId != null &&
        exists(/databases/$(database)/documents/objectives/$(objectiveId)) &&
        get(/databases/$(database)/documents/objectives/$(objectiveId)).data.createdBy == request.auth.uid;
    }

    // Une tâche libre (objectiveId == null) est toujours partagée. Une tâche liée
    // à un objectif hérite de sa visibilité — c'est la seule source de vérité,
    // la tâche elle-même n'a pas son propre champ de visibilité.
    function canAccessObjectiveId(objectiveId) {
      return !isPrivateObjective(objectiveId) || ownsObjective(objectiveId);
    }

    // Visibilité héritée de l'objectif référencé (ou "shared" si pas d'objectif
    // ou objectif introuvable) — utilisée pour vérifier que le champ
    // `visibility` recopié sur une tâche/rubrique (voir plus bas) est correct.
    function visibilityOfObjectiveId(objectiveId) {
      return objectiveId == null ||
        !exists(/databases/$(database)/documents/objectives/$(objectiveId))
        ? 'shared'
        : get(/databases/$(database)/documents/objectives/$(objectiveId)).data.get('visibility', 'shared');
    }

    match /objectives/{objectiveId} {
      allow read: if isFamilyMember() &&
        (resource.data.get('visibility', 'shared') != 'private' ||
          resource.data.get('createdBy', null) == request.auth.uid);
      allow create: if isFamilyMember();
      allow update, delete: if isFamilyMember() &&
        (resource.data.get('visibility', 'shared') != 'private' ||
          resource.data.get('createdBy', null) == request.auth.uid);
    }

    // IMPORTANT — pourquoi `visibility` est recopié sur chaque tâche/rubrique :
    // Firestore n'applique PAS les règles document par document sur une requête
    // de liste (`list`/onSnapshot sans filtre) quand la condition dépend d'un
    // get() sur un AUTRE document (ici l'objectif référencé) : la requête est
    // alors autorisée dans son ensemble sans filtrer les résultats, et un
    // document qui aurait dû être refusé (ex. tâche liée à l'objectif privé de
    // quelqu'un d'autre) est quand même renvoyé — vérifié empiriquement avec
    // l'émulateur (firebase-rules/__tests__/firestore.rules.test.ts). Un champ
    // `visibility` propre au document, lui, peut être ciblé par un `where()`
    // (`where('visibility','==','shared')` / `where('createdBy','==',uid)`
    // côté client, voir src/services/tasks.ts et budgetItems.ts) que Firestore
    // sait prouver sûr à partir de la requête elle-même, donc correctement
    // appliqué même en liste. `canAccessObjectiveId` (get() sur l'objectif)
    // reste utilisé en écriture (création/modification, jamais en liste) pour
    // empêcher de rattacher une tâche/rubrique à l'objectif privé d'un autre
    // membre ; le check d'égalité ci-dessous garantit en plus que la valeur de
    // `visibility` envoyée par le client correspond bien à la vraie visibilité
    // de l'objectif référencé (pas de mensonge possible côté client).
    match /budgetItems/{budgetItemId} {
      allow read: if isFamilyMember() &&
        (resource.data.get('visibility', 'shared') != 'private' ||
          resource.data.get('createdBy', null) == request.auth.uid);
      allow create: if isFamilyMember() &&
        canAccessObjectiveId(request.resource.data.get('objectiveId', null)) &&
        request.resource.data.get('visibility', 'shared') ==
          visibilityOfObjectiveId(request.resource.data.get('objectiveId', null));
      // update vérifie l'objectif actuel ET le nouveau (sinon on pourrait
      // rattacher une rubrique à l'objectif privé de quelqu'un d'autre sans y
      // avoir accès). delete n'a pas de request.resource, donc règle séparée.
      allow update: if isFamilyMember() &&
        canAccessObjectiveId(resource.data.get('objectiveId', null)) &&
        canAccessObjectiveId(request.resource.data.get('objectiveId', null)) &&
        request.resource.data.get('visibility', 'shared') ==
          visibilityOfObjectiveId(request.resource.data.get('objectiveId', null));
      allow delete: if isFamilyMember() &&
        canAccessObjectiveId(resource.data.get('objectiveId', null));
    }

    match /tasks/{taskId} {
      allow read: if isFamilyMember() &&
        (resource.data.get('visibility', 'shared') != 'private' ||
          resource.data.get('createdBy', null) == request.auth.uid);
      allow create: if isFamilyMember() &&
        canAccessObjectiveId(request.resource.data.get('objectiveId', null)) &&
        request.resource.data.get('visibility', 'shared') ==
          visibilityOfObjectiveId(request.resource.data.get('objectiveId', null));
      allow update: if isFamilyMember() &&
        canAccessObjectiveId(resource.data.get('objectiveId', null)) &&
        canAccessObjectiveId(request.resource.data.get('objectiveId', null)) &&
        request.resource.data.get('visibility', 'shared') ==
          visibilityOfObjectiveId(request.resource.data.get('objectiveId', null));
      allow delete: if isFamilyMember() &&
        canAccessObjectiveId(resource.data.get('objectiveId', null));

      // Le parent (la tâche) est déjà chargé par le match ci-dessus, mais les
      // règles des sous-collections ont leur propre contexte `resource` : on
      // relit la tâche pour retrouver son objectif et appliquer la même
      // restriction (commentaires/pièces jointes d'une tâche privée = privés).
      function canAccessParentTask() {
        return canAccessObjectiveId(
          get(/databases/$(database)/documents/tasks/$(taskId)).data.get('objectiveId', null)
        );
      }

      match /comments/{commentId} {
        allow read: if isFamilyMember() && canAccessParentTask();
        allow create, update, delete: if isFamilyMember() && canAccessParentTask();
      }

      match /attachments/{attachmentId} {
        allow read: if isFamilyMember() && canAccessParentTask();
        allow create, update, delete: if isFamilyMember() && canAccessParentTask();

        // Le contenu du fichier (encodé en base64) est découpé en morceaux
        // de documents ici, pour rester sous la limite de 1 Mio par document
        // Firestore — voir src/domain/attachments.ts.
        match /chunks/{chunkId} {
          allow read: if isFamilyMember() && canAccessParentTask();
          allow create, update, delete: if isFamilyMember() && canAccessParentTask();
        }
      }
    }
  }
}
