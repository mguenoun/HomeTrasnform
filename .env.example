# Copiez ce fichier en .env.local (ignoré par git) pour le développement local.
# En production/preview, ces valeurs sont définies dans les variables
# d'environnement du projet Cloudflare Pages, pas dans le dépôt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL du Cloudflare Worker qui gère les pièces jointes (voir worker/).
# En local avec `wrangler dev` : http://127.0.0.1:8787
VITE_ATTACHMENTS_WORKER_URL=
