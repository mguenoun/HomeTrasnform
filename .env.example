# Copiez ce fichier en .env.local (ignoré par git) pour le développement local.
# En production, ces valeurs sont injectées au build (`npm run build` lit
# .env.local), pas commitées dans le dépôt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Notifications push (Cloudflare Worker "hometransform-notifications")
VITE_VAPID_PUBLIC_KEY=
VITE_NOTIFICATIONS_WORKER_URL=
